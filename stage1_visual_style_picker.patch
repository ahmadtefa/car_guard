+// 6. Ring
+class _RingMicroPainter extends CustomPainter {
+  const _RingMicroPainter();
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final cx = size.width / 2;
+    final cy = size.height / 2;
+    final r = math.min(size.width, size.height) * 0.34;
+    final rect = Rect.fromCircle(center: Offset(cx, cy), radius: r);
+
+    const start = -math.pi / 2;
+    const sweep = math.pi * 2;
+
+    canvas.drawArc(
+      rect,
+      0,
+      sweep,
+      false,
+      Paint()
+        ..style = PaintingStyle.stroke
+        ..strokeWidth = 3.5
+        ..color = const Color(0xFF1E293B),
+    );
+
+    final gradient = const SweepGradient(
+      startAngle: start,
+      endAngle: start + sweep,
+      colors: [
+        AppColors.neonGreen,
+        AppColors.neonCyan,
+        AppColors.neonAmber,
+        AppColors.neonRed,
+      ],
+    );
+
+    final paint = Paint()
+      ..style = PaintingStyle.stroke
+      ..strokeWidth = 3.5
+      ..strokeCap = StrokeCap.round
+      ..shader = gradient.createShader(rect);
+
+    canvas.drawArc(rect, start, sweep * 0.65, false, paint);
+
+    final knobAngle = start + sweep * 0.65;
+    canvas.drawCircle(
+      Offset(cx + r * math.cos(knobAngle), cy + r * math.sin(knobAngle)),
+      2.5,
+      Paint()..color = Colors.white,
+    );
+
+    final tp = TextPainter(
+      text: const TextSpan(
+        text: '91°',
+        style: TextStyle(
+          color: Colors.white,
+          fontSize: 11,
+          fontWeight: FontWeight.bold,
+        ),
+      ),
+      textDirection: TextDirection.ltr,
+    )..layout();
+    tp.paint(canvas, Offset(cx - tp.width / 2, cy - tp.height / 2));
+  }
+
+  @override
+  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
